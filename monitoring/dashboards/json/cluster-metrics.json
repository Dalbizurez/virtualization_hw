{
  "uid": "cluster-daa",
  "title": "Cluster - CPU, Memoria y Pods (daa)",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "CPU por namespace (cores)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{namespace}}",
          "expr": "sum by (namespace) (rate(container_cpu_usage_seconds_total{container!=\"\"}[5m]))" }
      ]
    },
    {
      "id": 2, "type": "timeseries", "title": "Memoria por namespace",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{namespace}}",
          "expr": "sum by (namespace) (container_memory_working_set_bytes{container!=\"\"})" }
      ]
    },
    {
      "id": 3, "type": "piechart", "title": "Estado de los pods (todo el cluster)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 8 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] },
                   "legend": { "displayMode": "table", "placement": "right", "values": ["value"] } },
      "targets": [
        { "refId": "A", "instant": true, "legendFormat": "{{phase}}",
          "expr": "sum by (phase) (kube_pod_status_phase)" }
      ]
    },
    {
      "id": 4, "type": "stat", "title": "Pods Ready en parcial-daa",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 8, "y": 8, "w": 4, "h": 8 },
      "targets": [
        { "refId": "A",
          "expr": "sum(kube_pod_status_ready{namespace=\"parcial-daa\",condition=\"true\"})" }
      ]
    },
    {
      "id": 5, "type": "timeseries", "title": "CPU por pod en parcial-daa (cores)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{pod}}",
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"parcial-daa\",container!=\"\"}[5m]))" }
      ]
    }
  ]
}